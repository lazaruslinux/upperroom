# Caddy terminates TLS and routes traffic. It gets a real certificate from
# Let's Encrypt automatically, so the DNS record for your domain must point at
# this server and be set to DNS only (grey cloud) in Cloudflare. See
# docs/02-cloudflare.md for why.

{
	email {$TLS_EMAIL}
}

{$SELFSTREAM_DOMAIN} {
	encode zstd gzip

	route {
		# US-only country lock, enforced here on the server so the video never
		# has to pass through Cloudflare. The gate checks the visitor's country
		# for every single request. A blocked country gets a 403 and never
		# reaches the pages, the login, or the video.
		forward_auth gate:8000 {
			uri /api/geo
		}

		# Login, session, chat config, and stream status.
		handle /api/* {
			reverse_proxy gate:8000
		}

		# The chat and presence WebSocket. Caddy upgrades this for us.
		handle /ws {
			reverse_proxy gate:8000
		}

		# The video itself, served at the same /live/ paths MediaMTX uses so its
		# internal redirects and segment URLs line up (it redirects to absolute
		# paths, which breaks under a rewritten prefix). forward_auth checks the
		# session cookie first, so the stream is useless to anyone not signed in.
		handle /live/* {
			forward_auth gate:8000 {
				uri /api/verify
			}
			reverse_proxy mediamtx:8888
		}

		# Everything else is the static site: the login page, the watch page,
		# and the CSS and JavaScript.
		handle {
			root * /srv/web
			try_files {path} {path}.html /index.html
			file_server
		}
	}
}
