# Caddy terminates TLS and routes traffic. It gets a real certificate from
# Let's Encrypt automatically, so the DNS record for your domain must point at
# this server and be set to DNS only (grey cloud) in Cloudflare. See
# docs/02-cloudflare.md for why.

{
	email {$TLS_EMAIL}

	# Only our own network may claim to be a proxy. Without this Caddy believes
	# any X-Forwarded-For it is handed, so a caller can name their own address.
	# The gate then reads the right-most entry, the one Caddy wrote itself
	# (resolve_client_ip in gate/auth.py), which is the only entry a caller
	# cannot forge. Both halves are needed: this one decides who Caddy believes,
	# that one decides which entry the gate reads. Put another proxy in front of
	# Caddy and both have to learn about it, or the login rate limiter and the
	# country gate go back to reading a caller-supplied value.
	servers {
		trusted_proxies static private_ranges
	}
}

# Every hop to the gate carries the visitor's address as Caddy resolved it, in
# place of the X-Forwarded-For Caddy would otherwise build by appending. With a
# second proxy in front (a host-level Caddy on a shared box) appending would end
# with that proxy's private address, and the gate would see every visitor as one:
# one login rate limit for the whole internet, and a country lookup that misses.
# {client_ip} honours trusted_proxies above, so it is the visitor either way.
(to_gate) {
	header_up X-Forwarded-For {client_ip}
}

{$SELFSTREAM_DOMAIN} {
	encode zstd gzip

	# An access log, in JSON, so the host can watch for abuse and block it at the
	# firewall instead of in the application. Everything the app does to defend
	# itself still costs it a worker and a database read; a kernel-level block
	# costs nothing. See docs/05-security.md for the fail2ban side.
	#
	# Rolled and capped, because this is a small disk and an access log is
	# exactly the kind of file that quietly fills one.
	#
	# Two endpoints authenticate with a secret in the query string, because
	# neither can send a header: the projector's socket (?key=) and the OBS
	# overlay browser source (?overlay=). Caddy logs the whole request target,
	# so without this filter every connection writes a live credential into a
	# file that is rolled, compressed, copied into backups and pasted into bug
	# reports. The gate redacts its own access lines already; this is the same
	# rule on the proxy side, and the two together are what actually keeps keys
	# out of logs. The path is kept, because it is what makes the line useful.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete key
					delete overlay
				}
				# The overlay page's own requests (its script, its fonts) name
				# the page they came from, key and all, in Referer.
				request>headers>Referer delete
			}
		}
	}

	# Caching policy. Versioned assets (their URLs carry ?v=N) can be cached hard
	# and forever. Everything else, above all the HTML documents, must always be
	# revalidated so a new deploy is picked up without anyone clearing their cache.
	@assets path /assets/*
	@dynamic not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @dynamic Cache-Control "no-cache"

	# The content security policy for every page. Everything the site runs is
	# its own: no inline script, no inline style, no script or font from anyone
	# else, so a script tag somebody managed to smuggle into a page has nowhere
	# to load from and no way to run inline. Setting a style from JavaScript
	# (element.style) is still allowed; style attributes in markup are not.
	#
	# Past 'self', each extra source has a reason:
	#   img-src data: blob:   the avatar crop draws a picked file (blob:), and
	#                         the browser's own form widgets use data: images.
	#   media-src blob:       hls.js plays the stream through Media Source
	#                         Extensions, which hands the video a blob: URL.
	#   worker-src blob:      hls.js parses segments in a worker it builds from
	#                         a blob:.
	#   connect-src wss://{host}   the chat socket. 'self' already covers it
	#                         in current browsers; some older Safari releases do
	#                         not count a wss: address as 'self', and on a phone
	#                         that would be the whole room without chat. Same
	#                         host only.
	#
	# frame-ancestors keeps its old job: only this site may frame these pages.
	# The dashboard frames the watch page and the watch page accepts messages
	# from the page framing it, so a stranger's site cannot embed it, overlay
	# it, and collect the clicks.
	header @dynamic Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{host}; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

	# Browser hardening that costs nothing. HSTS pins HTTPS for a year on this
	# host only: no includeSubDomains and no preload, because other names under
	# the same domain are not this site's to commit. nosniff stops a browser
	# guessing a file's type. The referrer policy gives other sites the origin
	# and never a path. And the pages ask for no camera, microphone, location or
	# payment, so nothing that ends up on one can be granted them.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	route {
		# The chat and presence WebSocket, handled before the geo gate below. A
		# forward_auth cannot proxy a WebSocket upgrade (it 403s it), and the
		# socket already requires a valid login cookie, which can only be issued
		# to an allowed country. The gate rechecks the country on the socket too.
		handle /ws {
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# The projector's socket, for the same reason and so it must sit here
		# too. It authenticates with a key in the URL rather than a login
		# cookie, and the gate rate-limits the attempts before reading it.
		handle /ws/projector {
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# US-only country lock, enforced here on the server so the video never
		# has to pass through Cloudflare. The gate checks the visitor's country
		# for every single request. A blocked country gets a 403 and never
		# reaches the pages, the login, or the video.
		forward_auth gate:8000 {
			uri /api/geo
			import to_gate
		}

		# Avatar upload is the one endpoint that legitimately carries a file, so
		# it gets its own ceiling. The gate enforces its own limit too (2 MB,
		# MAX_AVATAR_BYTES); this one is deliberately a little looser so a
		# slightly-too-big upload gets the app's clear error rather than a bare
		# 413 from the proxy.
		handle /api/avatar {
			request_body {
				max_size 3MB
			}
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# Login, session, chat config, and stream status.
		#
		# Everything here takes a small JSON body, so cap it hard. Without a cap
		# a single unauthenticated caller can post megabytes to /api/register or
		# /api/auth and the gate will buffer and parse all of it before it can
		# reject it, which on a small box is a cheap way to exhaust memory. 64 KB
		# is far more than any request here needs. Rejecting at the proxy means
		# the bytes never reach Python at all.
		handle /api/* {
			request_body {
				max_size 64KB
			}
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# The video itself, served at the same /live/ paths MediaMTX uses so its
		# internal redirects and segment URLs line up (it redirects to absolute
		# paths, which breaks under a rewritten prefix). forward_auth checks the
		# session cookie first, so the stream is useless to anyone not signed in.
		# The scope in the uri tells the gate which door this is (the live room,
		# where the viewer limit applies), so it never has to trust the path.
		handle /live/* {
			forward_auth gate:8000 {
				uri /api/verify?scope=live
				import to_gate
			}
			reverse_proxy mediamtx:8888
		}

		# Theater posters, which everyone in the room sees. Before /media/*
		# below, which would otherwise take them. They live on the gate's
		# own data volume rather than in the media store (they are not
		# recordings), so the gate serves them, and checks the session again
		# itself. The whole path is passed on, not stripped, because the gate's
		# route is /media/art/<name>.
		handle /media/art/* {
			forward_auth gate:8000 {
				uri /api/verify?scope=art
				import to_gate
			}
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# Saved recordings and clips, from the media store: a separate service
		# on this machine or another one, which answers range requests itself,
		# so seeking works. Behind the same session check as the live video, so
		# large files never pass through the gate. The prefix is stripped, so
		# /media/vods/<f> reaches the store as /vods/<f>.
		#
		# The store has its own key, and Caddy holds only the read one, which
		# can fetch a file and do nothing else. The viewer's cookie is removed
		# on the way: the store has no use for a session and must never be
		# handed one, so a store on another machine learns nothing about who is
		# watching and holds nothing that could be replayed against this site.
		handle_path /media/* {
			forward_auth gate:8000 {
				uri /api/verify?scope=media
				import to_gate
			}
			reverse_proxy {$SELFSTREAM_STORE_UPSTREAM} {
				header_up Authorization "Bearer {$SELFSTREAM_STORE_READ_KEY}"
				header_up -Cookie
			}
		}

		# Published clips: the one thing on this site deliberately reachable
		# without signing in. Note what is and is not relaxed here.
		#
		# The country gate above still applies, because it is a site-wide policy
		# and a share link is not a reason to drop it. What is missing is the
		# forward_auth to /api/verify that every other media path carries, so no
		# session is needed.
		#
		# The whole credential is the filename: a clip is only reachable at
		# /shared/<token>.mp4 where the token is 16 random bytes, and only the
		# publish path ever creates a file in here. The store never lists a
		# directory over a read, so the tokens cannot be discovered by asking
		# for the folder. The path is passed on whole, so it can only ever name
		# the store's public area, and the same read key and the same cookie
		# rule apply as above.
		handle /shared/* {
			reverse_proxy {$SELFSTREAM_STORE_UPSTREAM} {
				header_up Authorization "Bearer {$SELFSTREAM_STORE_READ_KEY}"
				header_up -Cookie
			}
		}

		# The page that wraps a shared clip, rendered by the gate rather than
		# served off disk so its link preview can name the clip, the channel
		# and the game, and carry a frame of it. Like /watch this takes no
		# forward_auth: a preview fetcher has no session. The page is still
		# only a shell, and the video and its poster come from /shared/*
		# above.
		handle /clip/* {
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# The watch page is served by the gate rather than off disk, so its link
		# preview can say who is streaming what and carry a current frame. A
		# preview fetcher has no session, which is why this sits below the geo
		# gate (still enforced) but takes no forward_auth of its own. The page it
		# returns is only a shell: the video, the chat socket and the library
		# each check the session separately. Exact path only, so /watch.html and
		# everything else stay with the static handler below.
		handle /watch {
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# An invite link, /join#<code>: the sign-in page with a card that says
		# whose room it is, rendered by the gate and routed exactly as /watch
		# is. The code rides after the #, which a browser never sends, so it
		# never reaches this log, the gate or a preview fetcher. Exact path.
		handle /join {
			reverse_proxy gate:8000 {
				import to_gate
			}
		}

		# Accounts, bans and invites moved onto the dashboard. Kept so an old
		# bookmark lands somewhere useful instead of the sign-in page.
		redir /accounts /admin permanent

		# Everything else is the static site: the login page, the watch page,
		# and the CSS and JavaScript.
		handle {
			root * /srv/web
			try_files {path} {path}.html /index.html
			file_server
		}
	}
}
