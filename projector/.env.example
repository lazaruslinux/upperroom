# The projector's settings. Copy to .env next to this file and fill it in.
# Nothing here is committed; the whole file is secrets and addresses.
#
# The projector connects OUT to your gate. It never listens, so this machine
# needs no open port, no certificate and no name in DNS.

# ---- The gate ---------------------------------------------------------------
# Your site's projector socket. wss:// over the internet, ws:// only on a link
# you already trust end to end (a LAN, a private tunnel).
PROJECTOR_GATE_URL=wss://your-domain/ws/projector
# Generate this in the dashboard, under Projector. Treat it like a password.
PROJECTOR_KEY=

# ---- Publishing --------------------------------------------------------------
# The same RTMP ingest and stream key OBS would use (dashboard, Stream key).
PROJECTOR_INGEST_URL=rtmp://your-domain:1935/live
PROJECTOR_STREAM_KEY=

# ---- The library -------------------------------------------------------------
# Your Jellyfin server and an API key from its dashboard. Not needed in demo mode.
JELLYFIN_URL=http://your-media-server:8096
JELLYFIN_API_KEY=

# ---- Encoding ----------------------------------------------------------------
# A render node to encode with VAAPI, e.g. /dev/dri/renderD128. Leave it unset to
# encode on the CPU with libx264. Passing a device in also means passing it into
# the container (--device) if you run this with Docker.
PROJECTOR_VAAPI_DEVICE=
PROJECTOR_VIDEO_BITRATE=6000k
PROJECTOR_MAX_HEIGHT=1080

# ---- Demo mode ---------------------------------------------------------------
# 1 plays three built-in generated titles and never touches a library, so you can
# try a theater session with nothing else set up.
PROJECTOR_DEMO=
