# Copy this file to .env and fill in every value. The .env file is never
# committed, so your secrets stay off GitHub.

# The public hostname for your stream, with no protocol.
# Example: watch.example.com
SELFSTREAM_DOMAIN=watch.example.com

# Secret used to sign session cookies. Generate a fresh one with:
#   openssl rand -hex 32
SELFSTREAM_JWT_SECRET=replace-with-openssl-rand-hex-32

# How long a viewer stays signed in, in hours.
SELFSTREAM_SESSION_HOURS=6

# How many days of chat history the admin dashboard keeps. Viewers always see
# chat as ephemeral; this only affects the admin-only log. Set to 0 to keep
# nothing. Optional, defaults to 7.
SELFSTREAM_CHAT_RETENTION_DAYS=7

# How often, in seconds, the live preview thumbnail on the home card refreshes
# while the stream is live. Optional, defaults to 15.
SELFSTREAM_THUMB_INTERVAL=15

# Seconds one person waits between clips, and the shorter wait for the host.
# Viewers and moderators share the first. Optional, default 300 and 60.
SELFSTREAM_CLIP_COOLDOWN=300
SELFSTREAM_CLIP_COOLDOWN_HOST=60

# Chat is wiped per night rather than per broadcast, so it survives a stream
# ending and carries into a theater session. The wipe happens when a broadcast
# starts and the last one ended longer ago than this, in seconds (default six
# hours, so an OBS restart never clears the room mid-evening). The second value
# is the backstop that clears a night nothing followed. Both optional.
SELFSTREAM_NIGHT_GAP=21600
SELFSTREAM_CHAT_IDLE_WIPE=86400

# How long someone may be gone before the room is told they left, in seconds.
# A phone that switches tabs drops its connection and makes a new one on the way
# back, which used to announce a departure and an arrival every time. Both lines
# wait this long, so glancing at another app is silent to everybody else.
# Optional.
SELFSTREAM_JOIN_GRACE=60

# Theater mode: play titles from your own media library to the room through the
# projector service (docs/11-theater.md). Off unless set to 1, and while it is
# off the pages show no theater controls and the projector socket refuses.
# Optional.
SELFSTREAM_THEATER=0

# Recordings (VODs). Every broadcast is recorded automatically. How much of that
# you keep is set in the admin dashboard, under Storage: limits on the number of
# recordings and clips, their age, and the total size of the media store, plus a
# pin that exempts anything you want to keep for good. A new install keeps
# everything until you say otherwise.
#
# The two settings below are only read once, when updating an install that
# predates the dashboard controls: their values seed the dashboard so your disk
# usage does not change under you. After that they are ignored, and you can
# delete them.
SELFSTREAM_VOD_KEEP=20
SELFSTREAM_VOD_KEEP_DAYS=0

# Recordings and clips live in the media store, a small service of its own
# (store/) that the gate and Caddy reach with these two keys. Generate each one
# with:
#   openssl rand -hex 32
# and use two different values. The store refuses to start if either is
# missing, shorter than 32 characters, or the same as the other.
#
# The write key is the gate's: it uploads, remuxes, links and deletes.
SELFSTREAM_STORE_KEY=replace-with-openssl-rand-hex-32
# The read key is Caddy's, and it can only fetch a file.
SELFSTREAM_STORE_READ_KEY=replace-with-a-different-openssl-rand-hex-32

# By default the store runs beside the gate against a docker volume named
# media_data, so a fresh checkout just works. To keep the archive on another
# machine, run store/ there and point both of these at it (the gate's URL and
# Caddy's host:port), then switch the local store off in your uncommitted
# docker-compose.override.yml. A broadcast is always recorded to local scratch
# first and only archived when it ends, so a store on the far side of a network
# is never in the path of a live stream, and an archive that fails is retried
# rather than lost. See docs/04-run.md, and docs/05-security.md.
# SELFSTREAM_STORE_URL=http://STORE_TAILNET_IP:8080
# SELFSTREAM_STORE_UPSTREAM=STORE_TAILNET_IP:8080

# Comma separated list of two letter country codes allowed to reach the site.
# Everyone else gets a 403. Leave blank to allow every country.
SELFSTREAM_ALLOWED_COUNTRIES=US

# Optional. The stream key OBS uses to publish now lives in the app: it is
# generated the first time you open the dashboard's Go live screen, where its
# first step, Settings in OBS, shows (and regenerates) it. This value only seeds
# that key on the very first start, so an existing install keeps its old key;
# changing it later does nothing once a key exists. Leave it blank unless you
# want a specific starting key or you run the demo profile (which publishes with
# this value).
PUBLISH_PASS=

# Email address for Let's Encrypt certificate notices.
TLS_EMAIL=you@example.com

# ---- Go-live notifications -------------------------------------------------
# When a broadcast starts, upperroom sends a push notification to every device
# whose owner turned it on in Options. No email is involved and nothing else
# needs setting up: the push keys are made on first start and kept in the
# database. The dashboard has the on/off switch and a test button.

# Full public URL of your site. Include the protocol. Push notifications need
# it (it is the contact address push services see), and link previews use it.
# Left blank, push is off. Example: https://watch.example.com
SELFSTREAM_SITE_URL=https://watch.example.com

# Minimum seconds between go-live announcements, so a brief stream blip or a
# restart cannot re-announce. Optional, defaults to 1800 (30 minutes).
SELFSTREAM_NOTIFY_COOLDOWN=1800

# ---- Demo mode (optional) --------------------------------------------------
# Only used by `docker compose --profile demo up -d`, which brings the site up
# already alive with demo accounts and a synthetic broadcast for evaluation. The
# plain `docker compose up -d` ignores these entirely. See docs/07-demo.md.
#
# Login for the seeded demo admin. The two seeded viewer accounts (viewer_one,
# viewer_two) use the same password. These have safe defaults, so you can leave
# them unset. Never point the demo profile at a real instance's .env.
DEMO_ADMIN_USER=demo
DEMO_ADMIN_PASSWORD=demodemo123
