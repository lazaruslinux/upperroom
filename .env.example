# Copy this file to .env and fill in every value. The .env file is never
# committed, so your secrets stay off GitHub.

# The public hostname for your stream, with no protocol.
# Example: watch.example.com
SELFSTREAM_DOMAIN=watch.example.com

# Secret used to sign session cookies. Generate a fresh one with:
#   openssl rand -hex 32
SELFSTREAM_JWT_SECRET=replace-with-openssl-rand-hex-32

# How long a viewer stays signed in, in hours.
SELFSTREAM_SESSION_HOURS=6

# Comma separated list of two letter country codes allowed to reach the site.
# Everyone else gets a 403. Leave blank to allow every country.
SELFSTREAM_ALLOWED_COUNTRIES=US

# The password OBS uses to publish the stream. Keep it private. This is not a
# viewer password, it only lets your OBS send video to the server.
PUBLISH_PASS=replace-with-a-long-publish-password

# Email address for Let's Encrypt certificate notices.
TLS_EMAIL=you@example.com
