# Copy this file to .env and fill in every value. The .env file is never
# committed, so your secrets stay off GitHub.

# The public hostname for your stream, with no protocol.
# Example: watch.example.com
SELFSTREAM_DOMAIN=watch.example.com

# Secret used to sign session cookies. Generate a fresh one with:
#   openssl rand -hex 32
SELFSTREAM_JWT_SECRET=replace-with-openssl-rand-hex-32

# How long a viewer stays signed in, in hours.
SELFSTREAM_SESSION_HOURS=6

# How many days of chat history the admin dashboard keeps. Viewers always see
# chat as ephemeral; this only affects the admin-only log. Set to 0 to keep
# nothing. Optional, defaults to 7.
SELFSTREAM_CHAT_RETENTION_DAYS=7

# How often, in seconds, the live preview thumbnail on the home card refreshes
# while the stream is live. Optional, defaults to 15.
SELFSTREAM_THUMB_INTERVAL=15

# Recordings (VODs). Every broadcast is recorded automatically. To keep the disk
# from filling up, only the most recent SELFSTREAM_VOD_KEEP recordings are kept;
# older ones are deleted. Set to 0 for no count limit. Optional, defaults to 20.
SELFSTREAM_VOD_KEEP=20

# Optionally also delete recordings older than this many days. 0 disables the
# age limit (so only the count limit above applies). Optional, defaults to 0.
SELFSTREAM_VOD_KEEP_DAYS=0

# By default, recordings and clips live in a docker volume named media_data, so
# a fresh checkout just works. To store them somewhere with more room (a big
# disk, a NAS, a ZFS dataset), create an uncommitted docker-compose.override.yml
# that points the media_data mount at your own path. See docs/04-run.md.

# Comma separated list of two letter country codes allowed to reach the site.
# Everyone else gets a 403. Leave blank to allow every country.
SELFSTREAM_ALLOWED_COUNTRIES=US

# The password OBS uses to publish the stream. Keep it private. This is not a
# viewer password, it only lets your OBS send video to the server.
PUBLISH_PASS=replace-with-a-long-publish-password

# Email address for Let's Encrypt certificate notices.
TLS_EMAIL=you@example.com

# ---- Go-live notifications (all optional) ----------------------------------
# When a broadcast starts, selfstream can announce it over a Discord webhook
# and/or by email. Leave a channel's settings blank to skip that channel; with
# nothing set, no notifications are sent. The Discord webhook URL is set in the
# admin dashboard, not here.

# Full public URL of your stream, used for the "watch now" link inside
# notifications. Include the protocol. Example: https://watch.example.com
SELFSTREAM_SITE_URL=https://watch.example.com

# Minimum seconds between go-live announcements, so a brief stream blip or a
# restart cannot re-announce. Optional, defaults to 1800 (30 minutes).
SELFSTREAM_NOTIFY_COOLDOWN=1800

# SMTP relay for the go-live email (e.g. Brevo, Postmark, Fastmail). Leave
# SELFSTREAM_SMTP_HOST blank to disable email entirely.
SELFSTREAM_SMTP_HOST=
SELFSTREAM_SMTP_PORT=587
SELFSTREAM_SMTP_USER=
SELFSTREAM_SMTP_PASS=
# The From address subscribers will see. Example: notify@example.com
SELFSTREAM_SMTP_FROM=
